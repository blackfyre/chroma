<lexer>
  <config>
    <name>Blade</name>
    <dot_all>true</dot_all>
  </config>
  <rules>
    <state name="root">
      <rule pattern="\{\{--.*?--\}\}">
        <token type="Comment"/>
      </rule>
      <rule pattern="@\{\{.*?\}\}">
        <token type="Other"/>
      </rule>
      <rule pattern="(\{\{)(.*?)(\}\})">
        <bygroups>
          <token type="CommentPreproc"/>
          <using lexer="PHP"/>
          <token type="CommentPreproc"/>
        </bygroups>
      </rule>
      <rule pattern="(\{!!)(.*?)(!!\})">
        <bygroups>
          <token type="CommentPreproc"/>
          <using lexer="PHP"/>
          <token type="CommentPreproc"/>
        </bygroups>
      </rule>
      <rule pattern="(@php)(.*?)(@endphp)">
        <bygroups>
          <token type="Keyword"/>
          <using lexer="PHP"/>
          <token type="Keyword"/>
        </bygroups>
      </rule>
      <rule pattern="@@[a-zA-Z_]\w*">
        <token type="Other"/>
      </rule>
      <rule pattern="(?&lt;![\w.])(@[a-zA-Z_]\w*)([ \t]*)(\()">
        <bygroups>
          <token type="Keyword"/>
          <token type="TextWhitespace"/>
          <token type="Punctuation"/>
        </bygroups>
        <push state="arguments"/>
      </rule>
      <rule pattern="(?&lt;![\w.])@[a-zA-Z_]\w*">
        <token type="Keyword"/>
      </rule>
      <rule pattern="[^{@]+">
        <token type="Other"/>
      </rule>
      <rule pattern="[{@]">
        <token type="Other"/>
      </rule>
    </state>
    <state name="arguments">
      <rule pattern="\(">
        <token type="Punctuation"/>
        <push/>
      </rule>
      <rule pattern="\)">
        <token type="Punctuation"/>
        <pop depth="1"/>
      </rule>
      <rule pattern="[^()]+">
        <using lexer="PHP"/>
      </rule>
    </state>
  </rules>
</lexer>
